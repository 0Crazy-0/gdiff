#!/usr/bin/env fish

set -g VERSION "1.3.0"
set -g SCRIPT_DIR (realpath (status dirname))
set -g DEFAULT_RULE "$GDIFF_DEFAULT_RULE"
if test -z "$DEFAULT_RULE"
    set -g DEFAULT_RULE "/usr/share/gdiff/rule.txt"
    if not test -f "$DEFAULT_RULE"; and test -f "$SCRIPT_DIR/../share/rule.txt"
        set -g DEFAULT_RULE "$SCRIPT_DIR/../share/rule.txt"
    end
end
set -g config_home "$XDG_CONFIG_HOME"
if test -z "$config_home"
    set -g config_home "$HOME/.config"
end
set -g USER_RULE_TXT "$config_home/gdiff/rule.txt"
set -g USER_RULE_MD "$config_home/gdiff/rule.md"

set -g RED (set_color red)
set -g GREEN (set_color green)
set -g BOLD (set_color --bold)
set -g RESET (set_color normal)

# Global state (filled by parse_args)
set -g CUSTOM_RULE ""
set -g PRINT_ONLY false
set -g SHOW_RULE_PATH false
set -g RESTORE_RULE false
set -g DIFF_ONLY false
set -g COMMIT_FLAG false
set -g MESSAGE_FLAG false
set -g INFO false
set -g MODE staged
set -g COMMIT_TARGET ""
set -g COMMIT_HASH ""
set -g RULE_FILE ""
set -g REF_SHIFT 1

# Helpers
function die
    echo "$RED"Error:"$RESET" $argv >&2
    exit 1
end

# Message mode never uses a rule; diff-only does not either
function needs_rule
    if test "$DIFF_ONLY" = true; or test "$MESSAGE_FLAG" = true
        return 1
    end
    return 0
end

function detect_clipboard
    if type -q wl-copy; and test -n "$WAYLAND_DISPLAY"
        echo "wl-copy"
    else if type -q xclip; and test -n "$DISPLAY"
        echo "xclip -selection clipboard"
    else if type -q xsel; and test -n "$DISPLAY"
        echo "xsel --clipboard --input"
    else if type -q pbcopy
        echo "pbcopy"
    else if type -q clip.exe
        echo "clip.exe"
    else
        echo ""
    end
end

function show_help
    echo "$BOLD"USAGE"$RESET"
    echo "  gdiff [OPTIONS]"
    echo ""
    echo "$BOLD"OPTIONS"$RESET"
    echo "  -c, --commit [REF]  Diff of a commit: position, hash or ref (default: 1 = latest)"
    echo "  -m, --message [REF] Print the commit message: position, hash or ref (default: 1 = latest)"
    echo "  -i, --info          With --message: add a header with hash, author and date"
    echo "  -r, --rule <file>   Use a custom rule file (.txt or .md)"
    echo "  -p, --print         Print the output instead of copying to clipboard"
    echo "  -d, --diff-only     Copy only the diff, without the rule"
    echo "  --restore-rule      Restore default rule to ~/.config/gdiff/rule.txt"
    echo "  --rule-path         Show which rule file is being used"
    echo "  -v, --version       Show version"
    echo "  -h, --help          Show this help"
    echo ""
    echo "$BOLD"NOTES"$RESET"
    echo "  --message prints to the terminal, does not use a rule, and cannot be"
    echo "  combined with -c, -r, -p, -d, --restore-rule or --rule-path."
    echo ""
    echo "$BOLD"RULE PRECEDENCE"$RESET"
    echo "  1. --rule <file>                 (highest)"
    echo "  2. ~/.config/gdiff/rule.txt"
    echo "  3. /usr/share/gdiff/rule.txt     (default)"
end

function do_restore_rule
    set -l config_dir "$config_home/gdiff"
    set -l config_file "$config_dir/rule.txt"

    if not test -f "$DEFAULT_RULE"
        echo "$RED"Error:"$RESET Default rule not found at $DEFAULT_RULE" >&2
        return 1
    end

    if test -f "$config_file"
        set -l prompt_str (printf "%sWarning:%s A rule file already exists at %s. Overwrite? (y/N): " "$RED" "$RESET" "$config_file")
        read -l response -P "$prompt_str"
        switch "$response"
            case 'y' 'Y' 'yes' 'YES' 'Yes'

            case '*'
                echo "Operation cancelled."
                return 0
        end
    end

    mkdir -p "$config_dir"
    cp "$DEFAULT_RULE" "$config_file"
    echo "$GREEN"✓"$RESET Restored default rule to $config_file (from $DEFAULT_RULE)"
end

function resolve_rule
    set -l custom_rule "$argv[1]"

    if test -n "$custom_rule"
        if not test -f "$custom_rule"
            echo "$RED"Error:"$RESET Rule file not found: $custom_rule" >&2
            exit 1
        end
        echo "$custom_rule"
        return
    end

    # If running from the development repository, prioritize repo's share/rule.txt
    if test -e "$SCRIPT_DIR/../.git"; and test -f "$SCRIPT_DIR/../share/rule.txt"
        echo "$SCRIPT_DIR/../share/rule.txt"
        return
    end

    if test -f "$USER_RULE_TXT"
        echo "$USER_RULE_TXT"
        return
    end

    if test -f "$USER_RULE_MD"
        echo "$USER_RULE_MD"
        return
    end

    if test -f "$DEFAULT_RULE"
        echo "$DEFAULT_RULE"
        return
    end

    echo "$RED"Error:"$RESET No rule file found. Run 'gdiff --restore-rule' to create one." >&2
    exit 1
end

function lazy_init
    set -l config_dir "$config_home/gdiff"
    set -l config_file "$config_dir/rule.txt"
    set -l config_file_md "$config_dir/rule.md"

    if not test -f "$config_file"; and not test -f "$config_file_md"; and test -f "$DEFAULT_RULE"
        mkdir -p "$config_dir"
        cp "$DEFAULT_RULE" "$config_file"
    end
end

# Mode: staged
function require_staged
    if git diff --cached --quiet
        echo "$RED"Nothing staged."$RESET Use 'git add' to stage your changes first." >&2
        return 1
    end
end

function stream_staged
    git diff --cached --stat
    echo
    git diff --cached
end

# Mode: commit
# Prints the resolved commit hash on stdout; errors go to stderr.
function resolve_commit
    set -l commit_target "$argv[1]"
    set -l commit_hash ""

    if not git rev-parse --verify HEAD >/dev/null 2>&1
        echo "$RED"Error:"$RESET No commits found in repository." >&2
        return 1
    end

    if string match -qr -- '^[0-9]{1,6}$' "$commit_target"
        # Short all-digit values are positions in git log order, counting from
        # HEAD. Every reachable commit counts, including merge commits and the
        # commits of merged branches.
        if not string match -qr -- '^[1-9][0-9]*$' "$commit_target"
            echo "$RED"Error:"$RESET Invalid commit position '$commit_target'. Must be a positive integer (e.g. 1, 2, 3)." >&2
            return 1
        end

        set -l total_commits (git rev-list --count HEAD 2>/dev/null)
        if test "$commit_target" -gt "$total_commits"
            set -l commit_noun "commits"
            if test "$total_commits" -eq 1
                set commit_noun "commit"
            end
            echo "$RED"Error:"$RESET Commit at position $commit_target does not exist (branch only has $total_commits $commit_noun)." >&2
            return 1
        end

        set -l skip (math "$commit_target - 1")
        set commit_hash (git rev-list --skip="$skip" --max-count=1 HEAD 2>/dev/null)
        if test -z "$commit_hash"
            echo "$RED"Error:"$RESET Failed to resolve commit at position $commit_target." >&2
            return 1
        end
    else
        # Anything else is treated as a hash or ref
        if test -z "$commit_target"; or string match -q -- '-*' "$commit_target"
            echo "$RED"Error:"$RESET Invalid commit '$commit_target'. Use a position (e.g. 1, 2, 3) or a commit hash." >&2
            return 1
        end

        set commit_hash (git rev-parse --verify --quiet "$commit_target^{commit}" 2>/dev/null)
        if test -z "$commit_hash"
            echo "$RED"Error:"$RESET Commit '$commit_target' not found." >&2
            return 1
        end
    end

    echo "$commit_hash"
end

function stream_commit
    set -l commit_hash "$argv[1]"
    git show -m --first-parent --stat --format="" "$commit_hash"
    echo
    git show -m --first-parent -p --format="" "$commit_hash"
end

# Mode: message
# Prints the commit message exactly as it was written, without indentation.
# With with_info=true, a header (hash, short hash, author, date) goes first.
function print_commit_message
    set -l commit_hash "$argv[1]"
    set -l with_info "$argv[2]"

    set -l raw (git log -1 --format=%B "$commit_hash")
    or return 1
    set -l message (string join \n -- $raw | string collect)

    if test "$with_info" = true
        git log -1 --date=default --format="Commit: %H%nShort:  %h%nAuthor: %an <%ae>%nDate:   %ad" "$commit_hash"
        or return 1
        echo
    end

    printf '%s\n' "$message"
end

# Argument parsing

# If the next argument looks like a ref (not an option), consume it.
# Usage: parse_ref_arg $argv[$i..-1]   (where $argv[1] is the flag itself)
function parse_ref_arg
    if test (count $argv) -ge 2
        set -l next_val "$argv[2]"
        if not string match -q -- '-*' "$next_val"; or string match -qr -- '^-[0-9]+$' "$next_val"
            set -g COMMIT_TARGET "$next_val"
            set -g REF_SHIFT 2
            return
        end
    end
    set -g COMMIT_TARGET "1"
    set -g REF_SHIFT 1
end

function parse_args
    set -l i 1
    while test $i -le (count $argv)
        switch $argv[$i]
            case -c --commit
                set -g MODE commit
                set -g COMMIT_FLAG true
                parse_ref_arg $argv[$i..-1]
                set i (math $i + $REF_SHIFT)
            case '--commit=*'
                set -g MODE commit
                set -g COMMIT_FLAG true
                set -g COMMIT_TARGET (string replace -r '^--commit=' '' -- "$argv[$i]")
                set i (math $i + 1)
            case -m --message
                set -g MODE message
                set -g MESSAGE_FLAG true
                parse_ref_arg $argv[$i..-1]
                set i (math $i + $REF_SHIFT)
            case '--message=*'
                set -g MODE message
                set -g MESSAGE_FLAG true
                set -g COMMIT_TARGET (string replace -r '^--message=' '' -- "$argv[$i]")
                set i (math $i + 1)
            case -i --info
                set -g INFO true
                set i (math $i + 1)
            case -r --rule
                set -l next_i (math $i + 1)
                if test $next_i -gt (count $argv)
                    die "Option '$argv[$i]' requires an argument."
                end
                set -g CUSTOM_RULE "$argv[$next_i]"
                set i (math $i + 2)
            case -p --print
                set -g PRINT_ONLY true
                set i (math $i + 1)
            case -d --diff-only
                set -g DIFF_ONLY true
                set i (math $i + 1)
            case --restore-rule
                set -g RESTORE_RULE true
                set i (math $i + 1)
            case --rule-path
                set -g SHOW_RULE_PATH true
                set i (math $i + 1)
            case -v --version
                echo "gdiff v$VERSION"
                exit 0
            case -h --help
                show_help
                exit 0
            case '*'
                echo "$RED"Unknown option:"$RESET '$argv[$i]'" >&2
                echo "  Run 'gdiff --help' for a list of valid options." >&2
                exit 1
        end
    end
end

# Validate flag combinations before doing anything
function validate_flags
    if test "$MESSAGE_FLAG" = true
        set -l conflicts
        test "$COMMIT_FLAG" = true; and set -a -- conflicts --commit
        test -n "$CUSTOM_RULE"; and set -a -- conflicts --rule
        test "$PRINT_ONLY" = true; and set -a -- conflicts --print
        test "$DIFF_ONLY" = true; and set -a -- conflicts --diff-only
        test "$RESTORE_RULE" = true; and set -a -- conflicts --restore-rule
        test "$SHOW_RULE_PATH" = true; and set -a -- conflicts --rule-path

        if test (count $conflicts) -gt 0
            set -l joined (string join ", " -- $conflicts)
            die "--message cannot be combined with $joined."
        end
    end

    if test "$INFO" = true; and test "$MESSAGE_FLAG" = false
        die "--info can only be used with --message."
    end
end

# Setup steps used by main

# Message mode never uses a rule; diff-only does not either
function select_rule
    needs_rule; or return 0
    set -g RULE_FILE (resolve_rule "$CUSTOM_RULE")
    if test $status -ne 0
        exit 1
    end
end

function check_rule
    needs_rule; or return 0
    lazy_init
    if not test -s "$RULE_FILE"
        echo "$RED"Error:"$RESET Rule file is empty: $RULE_FILE" >&2
        echo "Please edit the file or run 'gdiff --restore-rule' to restore the default rule." >&2
        exit 1
    end
end

function check_environment
    if not type -q git
        die "git is not installed."
    end

    if not git rev-parse --git-dir >/dev/null 2>&1
        die "Not inside a git repository."
    end
end

function resolve_target
    switch "$MODE"
        case staged
            require_staged; or exit 1
        case commit message
            set -g COMMIT_HASH (resolve_commit "$COMMIT_TARGET")
            if test $status -ne 0
                exit 1
            end
    end
end

# Output
function emit_content
    switch "$MODE"
        case staged
            stream_staged
        case commit
            stream_commit "$COMMIT_HASH"
    end
    echo
    echo
    if needs_rule
        cat "$RULE_FILE"
    end
end

function deliver_output
    if test "$PRINT_ONLY" = true
        emit_content
        return 0
    end

    set -l clipboard_cmd (detect_clipboard)

    if test -z "$clipboard_cmd"
        echo "$RED"Error:"$RESET No clipboard tool found (wl-copy, xclip, xsel, pbcopy, clip.exe)." >&2
        echo "Use --print to output to stdout instead." >&2
        exit 1
    end

    if emit_content | eval "$clipboard_cmd"
        if test "$DIFF_ONLY" = true
            echo "$GREEN"✓"$RESET Diff copied to clipboard"
        else
            echo "$GREEN"✓"$RESET Diff + rule copied to clipboard"
        end
    else
        die "Failed to copy to clipboard."
    end
end

# Entry point
function main
    parse_args $argv
    validate_flags

    if test "$RESTORE_RULE" = true
        do_restore_rule
        exit $status
    end

    select_rule
    if test "$SHOW_RULE_PATH" = true
        echo "$RULE_FILE"
        exit 0
    end
    check_rule

    check_environment
    resolve_target

    if test "$MODE" = message
        print_commit_message "$COMMIT_HASH" "$INFO"
        return $status
    end

    deliver_output
end

main $argv
