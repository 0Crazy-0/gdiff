#!/usr/bin/env bash

VERSION="1.2.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
# Base directory for gdiff user configuration.
# On Windows (Git Bash / MSYS2 / Cygwin) use %APPDATA%\gdiff, the location
# Windows users expect; fall back to ~/.config/gdiff if APPDATA is unset.
# On unix honor XDG_CONFIG_HOME. There is no usable system /usr/share in
# Git Bash (it points inside the Git installation), so the default rule
# also lives in the user config dir there.
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
        CONFIG_BASE="${GDIFF_CONFIG_HOME:-${APPDATA:-$HOME/.config}/gdiff}"
        CONFIG_BASE="${CONFIG_BASE//\\//}"
        DEFAULT_RULE="${GDIFF_DEFAULT_RULE:-$SCRIPT_DIR/rule.default.txt}"
        ;;
    *)
        CONFIG_BASE="${XDG_CONFIG_HOME:-$HOME/.config}/gdiff"
        DEFAULT_RULE="${GDIFF_DEFAULT_RULE:-/usr/share/gdiff/rule.txt}"
        ;;
esac
if [ -z "${GDIFF_DEFAULT_RULE:-}" ] && [ ! -f "$DEFAULT_RULE" ] && [ -f "$SCRIPT_DIR/../share/rule.txt" ]; then
    DEFAULT_RULE="$SCRIPT_DIR/../share/rule.txt"
fi
USER_RULE_TXT="$CONFIG_BASE/rule.txt"
USER_RULE_MD="$CONFIG_BASE/rule.md"

RED='\033[0;31m'
GREEN='\033[0;32m'
BOLD='\033[1m'
RESET='\033[0m'

detect_clipboard() {
    if command -v wl-copy &>/dev/null && [ -n "$WAYLAND_DISPLAY" ]; then
        echo "wl-copy"
    elif command -v xclip &>/dev/null && [ -n "$DISPLAY" ]; then
        echo "xclip -selection clipboard"
    elif command -v xsel &>/dev/null && [ -n "$DISPLAY" ]; then
        echo "xsel --clipboard --input"
    elif command -v pbcopy &>/dev/null; then
        echo "pbcopy"
    elif command -v clip.exe &>/dev/null; then
        echo "clip.exe"
    else
        echo ""
    fi
}


show_help() {
    echo -e "${BOLD}USAGE${RESET}"
    echo "  gdiff [OPTIONS]"
    echo ""
    echo -e "${BOLD}OPTIONS${RESET}"
    echo "  -c, --commit [REF]  Diff of a commit: position, hash or ref (default: 1 = latest)"
    echo "  -r, --rule <file>   Use a custom rule file (.txt or .md)"
    echo "  -p, --print         Print the output instead of copying to clipboard"
    echo "  -d, --diff-only     Copy only the diff, without the rule"
    echo "  --restore-rule      Restore default rule to $CONFIG_BASE/rule.txt"
    echo "  --rule-path         Show which rule file is being used"
    echo "  -v, --version       Show version"
    echo "  -h, --help          Show this help"
    echo ""
    echo -e "${BOLD}RULE PRECEDENCE${RESET}"
    echo "  1. --rule <file>                 (highest)"
    echo "  2. $CONFIG_BASE/rule.txt"
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*) echo "  3. (no system-wide default on Windows)" ;;
        *) echo "  3. /usr/share/gdiff/rule.txt     (default)" ;;
    esac
}

do_restore_rule() {
    local config_file="$CONFIG_BASE/rule.txt"

    if [ ! -f "$DEFAULT_RULE" ]; then
        echo -e "${RED}Error:${RESET} Default rule not found at $DEFAULT_RULE" >&2
        return 1
    fi

    if [ -f "$config_file" ]; then
        echo -n -e "${RED}Warning:${RESET} A rule file already exists at $config_file. Overwrite? (y/N): "
        read -r response
        case "$response" in
            [yY][eE][sS]|[yY])
                ;;
            *)
                echo "Operation cancelled."
                return 0
                ;;
        esac
    fi

    mkdir -p "$CONFIG_BASE"
    cp "$DEFAULT_RULE" "$config_file"
    echo -e "${GREEN}✓${RESET} Restored default rule to $config_file (from $DEFAULT_RULE)"
}

resolve_rule() {
    local custom_rule="$1"

    if [ -n "$custom_rule" ]; then
        if [ ! -f "$custom_rule" ]; then
            echo -e "${RED}Error:${RESET} Rule file not found: $custom_rule" >&2
            exit 1
        fi
        echo "$custom_rule"
        return
    fi

    # if running from the development repository, prioritize repo's share/rule.txt
    if [ -e "$SCRIPT_DIR/../.git" ] && [ -f "$SCRIPT_DIR/../share/rule.txt" ]; then
        echo "$SCRIPT_DIR/../share/rule.txt"
        return
    fi

    if [ -f "$USER_RULE_TXT" ]; then
        echo "$USER_RULE_TXT"
        return
    fi

    if [ -f "$USER_RULE_MD" ]; then
        echo "$USER_RULE_MD"
        return
    fi

    if [ -f "$DEFAULT_RULE" ]; then
        echo "$DEFAULT_RULE"
        return
    fi

    echo -e "${RED}Error:${RESET} No rule file found. Run 'gdiff --restore-rule' to create one." >&2
    exit 1
}

lazy_init() {
    local config_file="$CONFIG_BASE/rule.txt"
    local config_file_md="$CONFIG_BASE/rule.md"

    if [ ! -f "$config_file" ] && [ ! -f "$config_file_md" ] && [ -f "$DEFAULT_RULE" ]; then
        mkdir -p "$CONFIG_BASE"
        cp "$DEFAULT_RULE" "$config_file"
    fi
}

# Mode: staged
require_staged() {
    if git diff --cached --quiet; then
        echo -e "${RED}Nothing staged.${RESET} Use 'git add' to stage your changes first." >&2
        return 1
    fi
}

stream_staged() {
    git diff --cached --stat
    echo
    git diff --cached
}

# Mode: commit
# Prints the resolved commit hash on stdout; errors go to stderr.
resolve_commit() {
    local commit_target="$1"
    local commit_hash=""

    if ! git rev-parse --verify HEAD &>/dev/null; then
        echo -e "${RED}Error:${RESET} No commits found in repository." >&2
        return 1
    fi

    if [[ "$commit_target" =~ ^[0-9]{1,6}$ ]]; then
        # Short all-digit values are positions in git log order, counting from
        # HEAD. Every reachable commit counts, including merge commits and the
        # commits of merged branches.
        if ! [[ "$commit_target" =~ ^[1-9][0-9]*$ ]]; then
            echo -e "${RED}Error:${RESET} Invalid commit position '$commit_target'. Must be a positive integer (e.g. 1, 2, 3)." >&2
            return 1
        fi

        local total_commits
        total_commits=$(git rev-list --count HEAD 2>/dev/null)
        if [ "$commit_target" -gt "$total_commits" ]; then
            local commit_noun="commits"
            if [ "$total_commits" -eq 1 ]; then
                commit_noun="commit"
            fi
            echo -e "${RED}Error:${RESET} Commit at position $commit_target does not exist (branch only has $total_commits $commit_noun)." >&2
            return 1
        fi

        local skip=$((commit_target - 1))
        commit_hash=$(git rev-list --skip="$skip" --max-count=1 HEAD 2>/dev/null)
        if [ -z "$commit_hash" ]; then
            echo -e "${RED}Error:${RESET} Failed to resolve commit at position $commit_target." >&2
            return 1
        fi
    else
        # Anything else is treated as a hash or ref
        if [[ -z "$commit_target" || "$commit_target" == -* ]]; then
            echo -e "${RED}Error:${RESET} Invalid commit '$commit_target'. Use a position (e.g. 1, 2, 3) or a commit hash." >&2
            return 1
        fi

        commit_hash=$(git rev-parse --verify --quiet "${commit_target}^{commit}" 2>/dev/null)
        if [ -z "$commit_hash" ]; then
            echo -e "${RED}Error:${RESET} Commit '$commit_target' not found." >&2
            return 1
        fi
    fi

    echo "$commit_hash"
}

stream_commit() {
    local commit_hash="$1"
    git show -m --first-parent --stat --format="" "$commit_hash"
    echo
    git show -m --first-parent -p --format="" "$commit_hash"
}

main() {
    local custom_rule=""
    local print_only=false
    local show_rule_path=false
    local diff_only=false
    local mode="staged"
    local commit_target=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -c|--commit)
                mode="commit"
                if [[ $# -ge 2 && ( ! "$2" =~ ^- || "$2" =~ ^-[0-9]+$ ) ]]; then
                    commit_target="$2"
                    shift 2
                else
                    commit_target="1"
                    shift
                fi
                ;;
            --commit=*)
                mode="commit"
                commit_target="${1#*=}"
                shift
                ;;
            -r|--rule)
                if [[ $# -lt 2 ]]; then
                    echo -e "${RED}Error:${RESET} Option '$1' requires an argument." >&2
                    exit 1
                fi
                custom_rule="$2"
                shift 2
                ;;
            -p|--print)
                print_only=true
                shift
                ;;
            -d|--diff-only)
                diff_only=true
                shift
                ;;
            --restore-rule)
                do_restore_rule
                exit $?
                ;;
            --rule-path)
                show_rule_path=true
                shift
                ;;
            -v|--version)
                echo "gdiff v${VERSION}"
                exit 0
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            *)
                echo -e "${RED}Unknown option:${RESET} '$1'" >&2
                echo "  Run 'gdiff --help' for a list of valid options." >&2
                exit 1
                ;;
        esac
    done

    local rule_file=""
    if ! $diff_only; then
        rule_file=$(resolve_rule "$custom_rule") || exit 1
    fi

    if $show_rule_path; then
        echo "$rule_file"
        exit 0
    fi

    if ! $diff_only; then
        lazy_init
    fi

    if ! $diff_only && [ ! -s "$rule_file" ]; then
        echo -e "${RED}Error:${RESET} Rule file is empty: $rule_file" >&2
        echo "Please edit the file or run 'gdiff --restore-rule' to restore the default rule." >&2
        exit 1
    fi
    if ! command -v git &>/dev/null; then
        echo -e "${RED}Error:${RESET} git is not installed." >&2
        exit 1
    fi

    if ! git rev-parse --git-dir &>/dev/null; then
        echo -e "${RED}Error:${RESET} Not inside a git repository." >&2
        exit 1
    fi

    local commit_hash=""
    case "$mode" in
        staged) require_staged || exit 1 ;;
        commit) commit_hash=$(resolve_commit "$commit_target") || exit 1 ;;
    esac

    stream_content() {
        case "$mode" in
            staged) stream_staged ;;
            commit) stream_commit "$commit_hash" ;;
        esac
        echo
        echo
        if ! $diff_only; then
            cat "$rule_file"
        fi
    }

    if $print_only; then
        stream_content
        return 0
    fi

    local clipboard_cmd
    clipboard_cmd=$(detect_clipboard)

    if [ -z "$clipboard_cmd" ]; then
        echo -e "${RED}Error:${RESET} No clipboard tool found (wl-copy, xclip, xsel, pbcopy, clip.exe)." >&2
        echo "Use --print to output to stdout instead." >&2
        exit 1
    fi

    if stream_content | $clipboard_cmd; then
        if $diff_only; then
            echo -e "${GREEN}✓${RESET} Diff copied to clipboard"
        else
            echo -e "${GREEN}✓${RESET} Diff + rule copied to clipboard"
        fi
    else
        echo -e "${RED}Error:${RESET} Failed to copy to clipboard." >&2
        exit 1
    fi
}

main "$@"
